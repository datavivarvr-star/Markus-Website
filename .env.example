# Copy to .env and fill in. The Docker Compose stack reads from this file.

# ----- Caddy reverse proxy -----
# Production:  your.domain.com  → Caddy auto-provisions a Let's Encrypt cert
# Local dev:   :80              → plain HTTP (docker-compose.override.yml
#                                 already sets this when you skip --skip)
DOMAIN=:80

# Optional: email used for Let's Encrypt rate-limit / expiry notifications.
# Leave blank in dev.
LETSENCRYPT_EMAIL=

# ----- Groq LLM (cloud) -----
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# ----- Piper TTS (self-hosted) -----
PIPER_URL=http://piper-tts:8001
PIPER_VOICE=en_US-ryan-medium
PIPER_ESPEAK_VOICE=en-us

# ----- Backend -----
PORT=3000
HOST=0.0.0.0
# Origin allowed for CORS / WebSocket.
# PRODUCTION: set this to your exact domain, e.g. https://markus.example.com
# Local dev only: use * or http://localhost:5173
ALLOWED_ORIGIN=https://your.domain.com
LOG_LEVEL=info
